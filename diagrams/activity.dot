digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman,", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman,", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="Разделить строку на элементы\nsplit(\";\", -1)" ];
n3 [label="Ровно пять значений?" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n4 [label="Для каждого из 5 элементов (цикл for):\nпроверить regex 0|[1-9][0-9]*,\nпреобразовать в int, проверить диапазон [0, 16]" ];
n5 [label="Все элементы корректны?" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n6 [label="Вычислить: total (сумма), average (2 знака),\novertimeDays (дни с v > 10), weeklyOvertime = max(0, sum − 40)" ];
n6b [label="Подсчитать тяжёлые смены:\naddHeavyDaysCount (дни с v > 12)" ];
n7 [label="Сформировать отчёт: сумма, среднее,\nдни с переработкой, недельная переработка" ];
n8 [label="Сформировать сообщение об ошибке\n(позиция или структура)" ];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n8 [label="нет"];
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n8 [label="нет (первая ошибка)"];
n6 -> n6b;
n6b -> n7;
n7 -> end;
n8 -> end;
}
